# Configure with locally generated synthetic demo values only.
DATABASE_URL=postgresql://localhost:5432/ttworkshop
# Must be the dedicated local test database; integration tests truncate its tables.
PG_TEST_URL=postgresql://localhost:5432/ttworkshop_test
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# To seed local synthetic identities, provide SEED_PASSWORD in your shell.
# Never commit a real credential or a .env with secrets.
# University timezone for datetime display (IANA format)
VITE_UNIVERSITY_TIMEZONE=Asia/Bangkok
